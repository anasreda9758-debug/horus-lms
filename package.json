{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "better-auth generate --config src/shared/auth.ts --output src/features/auth/schema.ts -y",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:curriculum": "tsx scripts/seed-curriculum.ts",
    "db:seed:quiz": "tsx scripts/seed-quiz.ts",
    "db:seed:plans": "tsx scripts/seed-plans.ts",
    "db:seed:testusers": "tsx scripts/seed-test-users.ts",
    "db:backup": "node scripts/backup.mjs backup",
    "db:restore": "node scripts/backup.mjs restore",
    "e2e": "node scripts/e2e.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@base-ui/react": "^1.7.0",
    "ai": "^7.0.66",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
