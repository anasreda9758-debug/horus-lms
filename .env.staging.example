# Copy to .env.staging on the VPS and fill in real values.
# Required (no defaults, startup will fail without them):
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_only
BETTER_AUTH_SECRET=CHANGE_ME_long_random_string

# Optional (defaults shown):
BETTER_AUTH_URL=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOG_LEVEL=info

# Admin account seeded on first deploy (docker `seed` service).
ADMIN_EMAIL=admin@horus.edu.eg
ADMIN_PASSWORD=CHANGE_ME_strong_password

# Content is bind-mounted from /opt/lms-content into the containers as /data;
# CONTENT_ROOT is fixed inside compose, do not override it here.
