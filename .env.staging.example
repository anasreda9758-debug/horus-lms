# Copy to .env.staging on the VPS and fill in real values.
# Required (no defaults, startup will fail without them):
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_only
BETTER_AUTH_SECRET=CHANGE_ME_long_random_string

# Optional (defaults shown):
BETTER_AUTH_URL=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOG_LEVEL=info
